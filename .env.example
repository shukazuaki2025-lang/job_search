# 邮箱 IMAP 同步配置模板（请复制为 .env 并填入你的真实信息，.env 已被 .gitignore 忽略，不会上传到 GitHub）
# 支持 Gmail / Outlook / QQ / 163 / 南信大校园邮箱

# 1. 邮箱提供商类型：gmail | outlook | custom
EMAIL_PROVIDER=outlook

# 2. 你的邮箱地址
EMAIL_ADDRESS=your_email@outlook.com

# 3. 邮箱应用专用密码 (App Password) 或 IMAP 授权码
# - Gmail: Google 账号 -> 安全性 -> 两步验证 -> 应用专用密码
# - Outlook: Microsoft 账号 -> 安全 -> 高级安全选项 -> 应用密码
EMAIL_APP_PASSWORD=your_app_password_here

# 4. 如使用 custom 自定义 IMAP 服务器，请填写：
IMAP_SERVER=outlook.office365.com
IMAP_PORT=993

# 5. 检索最近多少天的邮件（默认 180 天）
SEARCH_DAYS=180
